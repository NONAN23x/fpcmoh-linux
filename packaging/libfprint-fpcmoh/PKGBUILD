# SPDX-License-Identifier: LGPL-2.1-or-later
# Research package for the Mi NoteBook Ultra FPC 10a5:9200 sensor.

pkgname=libfprint-fpcmoh
pkgver=1.94.10.fpcmoh.10.gba10c939
pkgrel=1
pkgdesc='Pinned experimental libfprint with FPC Disum 10a5:9200 support'
url='https://gitlab.freedesktop.org/libfprint/libfprint/-/merge_requests/570'
arch=(x86_64)
license=(LGPL-2.1-or-later)

_commit=ba10c9398fe4542ff6403549884d0c8687182845

depends=(
  glib2
  glibc
  libgcc
  libgudev
  libgusb
  opencv
  openssl
  pixman
)
makedepends=(
  glib2-devel
  gobject-introspection
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  doctest
  umockdev
)
provides=(
  "libfprint=$pkgver"
  libfprint-2.so
)
conflicts=(libfprint)

source=(
  "https://gitlab.freedesktop.org/libfprint/libfprint/-/archive/$_commit/libfprint-$_commit.tar.gz"
)
sha256sums=(
  77021ac01625cfecba2187d67ab61ad0a23277eebbea41d009df914af6f760e9
)

build() {
  local meson_options=(
    -D drivers=all
    -D doc=false
    -D installed-tests=false
  )

  arch-meson "libfprint-$_commit" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-suite data
  build/libfprint/sigfm/sigfm-tests

  local hwdb
  hwdb="$(build/libfprint/fprint-list-udev-hwdb)"
  grep -Fq '# Supported by libfprint driver fpcmoh' <<< "$hwdb"
  grep -Fq 'usb:v10A5p9200*' <<< "$hwdb"
}

package() {
  meson install -C build --destdir "$pkgdir"

  local hwdb_dest="$pkgdir/usr/lib/udev/hwdb.d/60-autosuspend-libfprint-2.hwdb"
  install -d "${hwdb_dest%/*}"
  build/libfprint/fprint-list-udev-hwdb > "$hwdb_dest"
  chmod 0644 "$hwdb_dest"
}
